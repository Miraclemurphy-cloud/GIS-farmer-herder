# Settings for loading the hosted DEMO database from your computer (docs/DEPLOYMENT.md → "Free demo on Render").
# Copy to .env.demo (git-ignored) and fill in. Render must use the same JWT_SECRET and PHONE_ENC_KEY.

# Supabase: Connect → "Session pooler" string (port 5432). Neon: the project's connection string.
DATABASE_URL=

# Generate once:  openssl rand -base64 48 | tr -d '\n'
JWT_SECRET=
# Generate once:  openssl rand -base64 32 | tr '+/' '-_'
PHONE_ENC_KEY=

# First administrator (the per-role demo logins are generated separately into demo-credentials.txt)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Keep these as they are for a demo: no real SMS, synthetic history.
SMS_PROVIDER=console
ACLED_EMAIL=
ACLED_PASSWORD=
