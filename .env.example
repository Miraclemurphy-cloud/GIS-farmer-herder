# Backend
DATABASE_URL=postgresql+psycopg://gis:gis@localhost:5433/gis
REDIS_URL=redis://localhost:6380/0
JWT_SECRET=change-me
# Fernet key for encrypting subscriber phone numbers: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
PHONE_ENC_KEY=
ADMIN_EMAIL=admin@example.org
ADMIN_PASSWORD=change-me-too
CORS_ORIGINS=http://localhost:3000

# Data sources (optional — system runs on synthetic demo data without them)
# ACLED account (OAuth password grant, https://acleddata.com/api-documentation)
ACLED_EMAIL=
ACLED_PASSWORD=
FIRMS_MAP_KEY=

# SMS: provider = console | africastalking
SMS_PROVIDER=console
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=
# Inbound SMS callback: https://<host>/api/sms/inbound?token=<SMS_WEBHOOK_TOKEN>
SMS_WEBHOOK_TOKEN=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
